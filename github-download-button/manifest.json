{
  "manifest_version": 3,
  "name": "GitHub Releases Button",
  "version": "1.0",
  "description": "Adds an easily seen button to go to the Releases page on Github repos",

  "host_permissions": ["https://github.com/*"],

  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  }
}
